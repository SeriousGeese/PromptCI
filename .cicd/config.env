# Per-repo configuration for the shared PR-review engine (SeriousGeese/CICD).
#
# Read as DATA, never sourced, and read from the BASE commit rather than the PR
# head — this file configures the gate that decides whether a PR merges, so a PR
# must not be able to edit its own. (`.cicd/quality-gates.sh` next to it IS read
# from the head, deliberately: that one is product code.) Only names matching
# CICD_[A-Z0-9_]+ are honoured; anything else here is ignored.
#
# A value the workflow passes explicitly wins over the value here.

# The context this repo's ruleset actually requires. Verified against the live
# `main` ruleset (rule set 21056070), which requires exactly one: `ci`.
#
# This is a FALLBACK, used when the ruleset lookup fails. required_contexts()
# fails OPEN, so an empty or wrong value does not fail loudly — it quietly makes
# every skipped check count as a pass, and the merge gate stops gating. Keep it
# in step with the ruleset; there is no automated link between the two.
CICD_REQUIRED_CHECKS_FALLBACK=ci

# Only a skipped REQUIRED check counts as unresolved.
#
# NOT strict, and this repo specifically cannot be. Strict mode treats ANY
# skipped check as unresolved, which suits a repo whose whole matrix funnels into
# one aggregate `gate` job. Here, auto-merge.yml's `enable-automerge` job carries
# a job-level `if:` and therefore reports SKIPPED on every human-authored PR —
# under strict mode the reviewer would wait for a check that is already in its
# final state, on every PR, until the poll timeout.
#
# Non-strict is safe here for the reason strict exists to cover: `ci` is a single
# job with no job-level `if:`, so the required context cannot itself skip.
CICD_STRICT_SKIPPED=false

# Do not LLM-review Dependabot PRs; auto-merge.yml owns them.
#
# The reason is not cost. A Dependabot-triggered run receives no Actions secrets,
# so OPENROUTER_API_KEY arrives empty and the review cannot happen. Without this
# the engine reaches the LLM step, finds no key, and exits non-zero — which reads
# on the PR as "the bot reviewed this and objected". A bot that could not review
# must not present as one that reviewed and found the PR wanting.
CICD_FEATURE_DEPENDABOT_SKIP=1

# Left at the engine's defaults, with the reasoning recorded so a future reader
# can tell a considered default from an unexamined one:
#
#   CICD_FEATURE_STACKED_PRS       (on)  Three merge-hold guards — non-default
#                                        base branch, unmet `Depends-on:` refs,
#                                        and open PRs stacked on this head. None
#                                        is DnD-specific and each can only ever
#                                        add a reason NOT to merge, so leaving
#                                        them on costs nothing and the repo gets
#                                        the guard the day it first needs it.
#   CICD_FEATURE_APPROVE_HELD_RUNS (on)  The bot pushes with GITHUB_TOKEN, which
#                                        parks runs as `action_required`. This
#                                        repo grants `actions: write`, so the
#                                        approval works; without it the CI wait
#                                        expires and blames the wrong cause.
#   CICD_FEATURE_MIGRATION_JOURNAL (on)  Inert here — the guard looks for a
#                                        Drizzle migration journal and only DnD
#                                        has one.
#   CICD_FEATURE_E2E_GATE          (off) No e2e suite in this repo.
#   CICD_FEATURE_STAGE_DEPLOY      (off) No stage environment; this repo
#                                        publishes to npm on a tag instead.
#   CICD_FEATURE_BEADS             (off) This repo tracks issues in GitHub
#                                        Issues. Beads is promptci-cloud's.
