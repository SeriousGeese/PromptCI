node_modules/
dist/
*.tsbuildinfo
coverage/
# PromptCI: ignore generated reports, keep the shared baseline, config, and the
# committed badge JSON that backs the README health badge (regenerated by
# `pnpm selfscan:update`).
**/.promptci/*
!**/.promptci/baseline.json
!**/.promptci/config.json
!**/.promptci/health-badge.json
.DS_Store
