{
  "name": "@promptci/core",
  "version": "0.4.14",
  "description": "Deterministic scanner for AI coding instruction files (CLAUDE.md, AGENTS.md, .cursorrules) — detectors, scoring, and report generation",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeriousGeese/PromptCI.git",
    "directory": "packages/core"
  },
  "homepage": "https://promptci.seriousgeese.dev/docs/checks",
  "bugs": {
    "url": "https://github.com/SeriousGeese/PromptCI/issues"
  },
  "keywords": [
    "claude-md",
    "agents-md",
    "cursorrules",
    "copilot-instructions",
    "claude-code",
    "ai-coding-agents",
    "instruction-files",
    "prompt-lint",
    "linter",
    "cli",
    "ci"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*",
    "@types/micromatch": "*",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "micromatch": "^4.0.8"
  }
}
